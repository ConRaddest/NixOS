#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
config_path="$repo_root/shell/.qmlls.ini"
args=()

if [[ -e "$config_path" ]]; then
  vfs_config="$(readlink -f "$config_path")"
  vfs_dir="$(dirname -- "$vfs_config")"
  args+=(--build-dir "$vfs_dir" -I "$vfs_dir")
fi

exec qmlls "${args[@]}" "$@"
